flowchart TD
    subgraph E1["Epic 1 · HR Discovery & Scoping"]
        A["HR stakeholder discovery<br/>recruiters, hiring managers, DPO"] --> B["Validated workflow<br/>and pain points"]
        B --> C["Baseline KPI and guardrail metrics<br/>time, recall, adverse impact"]
        C --> D{"Rubric approved by<br/>HR and hiring managers?"}
        D -- No --> D1["Calibrate on annotated<br/>CV sample"]
        D1 --> D
    end

    D -- Yes --> E

    subgraph E2["Epic 2 · Parsing & Evaluation Engine"]
        E["Versioned evaluation schema<br/>rubric v1.x"] --> F0["Anonymize CV<br/>strip protected attributes"]
        F0 --> F["CV parser and<br/>evidence extraction"]
        F --> G["Rule-based scoring<br/>with confidence level"]
        G --> H["Evidence-backed<br/>candidate scorecard"]
        H --> I{"Confidence and<br/>completeness sufficient?"}
        I -- Yes --> J1["Recommendation:<br/>advance to phone screen"]
        I -- No --> J2["Flag:<br/>needs human review"]
    end

    J1 --> K
    J2 --> K

    subgraph E3["Human decision and governance"]
        K["Human recruiter review<br/>and final decision"] --> L["Audit log<br/>inputs, rubric and model version, decision"]
    end

    K --> M

    subgraph E4["Continuous improvement"]
        M["Measure<br/>time saved, recall, agreement,<br/>override rate, adverse impact"] --> N{"KPI and guardrails<br/>met?"}
        N -- Yes --> O["Extend to other roles"]
        N -- No --> P["Recalibrate rubric,<br/>prompts and thresholds"]
    end

    P --> D1

    classDef human fill:#FAEEDA,stroke:#BA7517,color:#412402
    classDef govern fill:#EEEDFE,stroke:#534AB7,color:#26215C
    classDef metric fill:#E1F5EE,stroke:#0F6E56,color:#04342C
    class K,J2 human
    class F0,L govern
    class C,M,N,O metric